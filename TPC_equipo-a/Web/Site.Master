<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Web.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />

    <%-- Tipografia del sitio --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Mooli&display=swap" rel="stylesheet" />

    <%-- Estilos propios de Ecommerce --%>
    <link href="~/Content/Ecommerce.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>
    <form runat="server" class="form">

        <asp:ScriptManager runat="server">
            <Scripts>
                <%-- Framework Scripts --%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />

            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg navbar-dark navbar-ecommerce">
            <div class="container-fluid">

                <a class="navbar-brand" runat="server" href="~/">Magva</a>

                <%-- el carrito queda afuera del menu asi en el celu se ve siempre al lado de la hamburguesa --%>
                <a class="carrito-nav ms-auto ms-lg-3 order-lg-last" runat="server" href="~/Carrito" title="Carrito" aria-label="Carrito">
                    <i class="bi bi-cart3"></i>
                    <asp:UpdatePanel ID="updBadgeCarrito" runat="server" UpdateMode="Always" RenderMode="Inline">
                        <ContentTemplate>
                            <asp:Label ID="lblCantidadCarrito" runat="server" CssClass="badge rounded-pill bg-danger contador-carrito" Visible="false"></asp:Label>
                        </ContentTemplate>
                    </asp:UpdatePanel>
                </a>

                <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/"><i class="bi bi-shop me-1"></i>Catálogo</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav mb-2 mb-lg-0">
                        <% if (Session["usuario"] != null)
                            { %>

                        <%-- en la compu es un desplegable con el nombre y en el celu las opciones quedan a la vista --%>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i><%: ((Dominio.Usuario)Session["usuario"]).Nombre %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" runat="server" href="~/MiPerfil"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
                                <li><a class="dropdown-item" runat="server" href="~/MisCompras"><i class="bi bi-bag me-2"></i>Mis compras</a></li>

                                <% if (((Dominio.Usuario)Session["usuario"]).Perfil != null &&
                                                 ((Dominio.Usuario)Session["usuario"]).Perfil.Id == 1)
                                    { %>
                                <li><a class="dropdown-item" runat="server" href="~/AdminProductos"><i class="bi bi-shield-lock me-2"></i>Panel admin</a></li>
                                <% } %>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>
                                <li><a class="dropdown-item" runat="server" href="~/CerrarSesion"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                            </ul>
                        </li>

                        <% }
                            else
                            { %>

                        <li class="nav-item">
                            <a class="btn btn-ecommerce-secundario w-100" runat="server" href="~/Login"><i class="bi bi-box-arrow-in-right me-1"></i>Ingresar</a>
                        </li>
                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            <a class="btn btn-ecommerce-primario w-100" runat="server" href="~/Registro"><i class="bi bi-person-plus me-1"></i>Registrarse</a>
                        </li>

                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer class="footer-ecommerce">
            <div class="container">
                <div class="row g-4">

                    <%-- en el celu la marca ocupa todo el ancho y las dos listas quedan una al lado de la otra --%>
                    <div class="col-12 col-md-6 col-lg-8">
                        <p class="marca-footer">Magva</p>
                        <p class="frase-footer">Las mejores cosas siempre están en Magva.</p>
                    </div>

                    <div class="col-6 col-md-3 col-lg-2">
                        <h3 class="h6">Tienda</h3>
                        <ul class="list-unstyled">
                            <li><a runat="server" href="~/"><i class="bi bi-shop"></i>Catálogo</a></li>
                            <li><a runat="server" href="~/Carrito"><i class="bi bi-cart3"></i>Carrito</a></li>
                        </ul>
                    </div>

                    <div class="col-6 col-md-3 col-lg-2">
                        <h3 class="h6">Mi cuenta</h3>
                        <ul class="list-unstyled">

                            <%-- mismas opciones que el desplegable de la navbar pero sin el panel admin --%>
                            <% if (Session["usuario"] != null)
                                { %>

                            <li><a runat="server" href="~/MiPerfil"><i class="bi bi-person"></i>Mi perfil</a></li>
                            <li><a runat="server" href="~/MisCompras"><i class="bi bi-bag"></i>Mis compras</a></li>
                            <li><a runat="server" href="~/CerrarSesion"><i class="bi bi-box-arrow-right"></i>Cerrar sesión</a></li>

                            <% }
                                else
                                { %>

                            <li><a runat="server" href="~/Login"><i class="bi bi-box-arrow-in-right"></i>Ingresar</a></li>
                            <li><a runat="server" href="~/Registro"><i class="bi bi-person-plus"></i>Registrarse</a></li>

                            <% } %>
                        </ul>
                    </div>

                </div>

                <p class="copy-footer">&copy; <%: DateTime.Now.Year %> Magva</p>
            </div>
        </footer>
    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.bundle.js") %>
    </asp:PlaceHolder>
</body>
</html>
